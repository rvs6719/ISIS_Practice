// 1. Справочник ролей (для RBAC)
Table Роль {
  id int [pk, increment, note: 'Идентификатор роли']
  название varchar [unique, note: 'admin / user / operator']
  описание varchar

  Note: 'Справочник ролей для разграничения прав доступа (RBAC).'
}

// 2. Центральная сущность
Table Пользователь {
  id int [pk, increment, note: 'Уникальный идентификатор']
  логин varchar [unique, note: 'Email или телефон']
  хеш_пароля varchar [note: 'Только хеш (Argon2id)']
  статус varchar [default: 'неподтвержден', note: 'неподтвержден / активен / заблокирован']
  неудачных_попыток int [default: 0]
  заблокирован_до timestamp [null]
  создан timestamp

  Note: 'Учётные записи. Пароли хранятся только в виде необратимого хеша.'
}

// 3. Связующая таблица для ролей (M:N)
Table Пользователь_Роль {
  id int [pk, increment]
  пользователь_id int [ref: > Пользователь.id, note: 'Ссылка на пользователя']
  роль_id int [ref: > Роль.id, note: 'Ссылка на роль']

  Note: 'Связь M:N. У пользователя может быть несколько ролей.'
}

// 4. Профиль (1:1)
Table Профиль_пользователя {
  id int [pk, increment]
  пользователь_id int [unique, ref: - Пользователь.id, note: 'Связь 1:1']
  фио varchar
  адрес_зашифрован text [note: 'Шифрование AES-256']
  телефон_зашифрован text [note: 'Шифрование AES-256']

  Note: 'Личные данные. Шифруются at-rest (на случай кражи БД).'
}

// 5. Настройки безопасности (1:1)
Table Настройки_безопасности {
  id int [pk, increment]
  пользователь_id int [unique, ref: - Пользователь.id]
  метод_2fa varchar [default: 'нет', note: 'нет / смс / email']
  секрет_2fa varchar [null, note: 'Зашифрованный секрет']
  подтвержден_email boolean [default: false]

  Note: 'Настройки двухфакторной аутентификации (2FA).'
}

// 6. Токены (1:N)
Table Токен_подтверждения {
  id int [pk, increment]
  пользователь_id int [ref: > Пользователь.id]
  хеш_токена varchar [note: 'Хранится только хеш токена!']
  тип varchar [note: 'подтверждение_email / сброс_пароля']
  истекает timestamp
  использован boolean [default: false]

  Note: 'Временные одноразовые токены для почты и сброса пароля.'
}

// 7. Бизнес-сущности (Посылки)
Table Посылка {
  id int [pk, increment]
  трек_номер varchar [unique]
  пользователь_id int [ref: > Пользователь.id, note: 'Владелец (защита от IDOR)']
  статус varchar
  адрес_получателя_зашифрован text [note: 'Шифрование AES-256']
  создана timestamp

  Note: 'Посылки. Запрос ВСЕГДА фильтруется по пользователь_id.'
}

// 8. Дочерняя таблица посылок (1:N)
Table Событие_посылки {
  id int [pk, increment]
  посылка_id int [ref: > Посылка.id]
  статус varchar
  местоположение varchar
  создано timestamp

  Note: 'История трекинга (для отображения в ЛК).'
}

// 9. Сессии (1:N)
Table Сессия {
  id int [pk, increment]
  пользователь_id int [ref: > Пользователь.id]
  хеш_токена varchar [note: 'Хеш токена сессии (не сам токен)']
  ip_адрес inet [note: 'Тип inet в PostgreSQL']
  истекает timestamp
  последняя_активность timestamp

  Note: 'Активные сессии. Выход удаляет запись.'
}

// 10. Логи входов (1:N)
Table Попытка_входа {
  id int [pk, increment]
  пользователь_id int [null, ref: > Пользователь.id, note: 'NULL, если логин не найден']
  логин_введён varchar
  ip_адрес inet
  успех boolean
  время timestamp

  Note: 'Лог попыток (основа для защиты от brute-force).'
}

// 11. Инциденты безопасности (1:N)
Table Инцидент_безопасности {
  id int [pk, increment]
  пользователь_id int [null, ref: > Пользователь.id, note: 'Нарушитель']
  тип_инцидента varchar [note: 'подбор_пароля / аномальный_вход / утечка']
  уровень_критичности varchar [note: 'низкий / средний / высокий']
  статус varchar [default: 'новый', note: 'новый / расследуется / закрыт']
  обнаружен timestamp

  Note: 'Журнал инцидентов ИБ для реагирования администраторами.'
}

// 12. Журнал аудита (1:N)
Table Журнал_аудита {
  id int [pk, increment]
  пользователь_id int [null, ref: > Пользователь.id, note: 'NULL — аноним']
  сессия_id int [null, ref: > Сессия.id]
  посылка_id int [null, ref: > Посылка.id]
  действие varchar [note: 'вход / выход / доступ / отказ / блокировка']
  результат varchar [note: 'успех / отказ']
  ip_адрес inet
  создано timestamp

  Note: 'Журнал аудита (Append-only). Изменение/удаление запрещены.'
}