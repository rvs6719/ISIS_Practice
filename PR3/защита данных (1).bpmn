        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCreds_di" bpmnElement="Task_EnterCreds">
        <dc:Bounds x="320" y="148" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetAccess_di" bpmnElement="Task_GetAccess">
        <dc:Bounds x="1220" y="148" width="100" height="80" />
