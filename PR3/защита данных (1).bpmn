      <bpmndi:BPMNShape id="Gateway_RightsOK_di" bpmnElement="Gateway_RightsOK" isMarkerVisible="true">
        <dc:Bounds x="945" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="847" y="397.5" width="66" height="27" />
