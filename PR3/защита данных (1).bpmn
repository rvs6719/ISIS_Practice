      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Denied_di" bpmnElement="EndEvent_Denied">
        <dc:Bounds x="1212" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1187" y="625" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Auth_di" bpmnElement="Task_Auth">
        <dc:Bounds x="420" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogAttempt_di" bpmnElement="Task_LogAttempt">
        <dc:Bounds x="420" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AuthOK_di" bpmnElement="Gateway_AuthOK" isMarkerVisible="true">
        <dc:Bounds x="615" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="527" y="396" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Authorize_di" bpmnElement="Task_Authorize">
        <dc:Bounds x="730" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="246" y="188" />
        <di:waypoint x="320" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
